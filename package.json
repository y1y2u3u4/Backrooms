{
  "name": "the-annex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "THE ANNEX - a first-person liminal horror experience for the browser.",
  "scripts": {
    "aotest": "node tools/qa/aotest.mjs",
    "artifacts": "node tools/qa/artifacts.mjs",
    "audio:render": "node tools/qa/audio-render.mjs --port 5307",
    "audiowiring": "node tools/qa/audiowiring.mjs",
    "audit": "node tools/qa/aotest.mjs && node tools/qa/props.mjs && node tools/qa/chain.mjs && node tools/qa/audiowiring.mjs && node tools/qa/floorgaps.mjs && node tools/qa/portalgraph.mjs && node tools/qa/lightreach.mjs",
    "blackout": "node tools/qa/lightreach.mjs --blackout",
    "build": "vite build",
    "capture": "node tools/qa/capture.mjs",
    "chain": "node tools/qa/chain.mjs",
    "crop": "node tools/qa/crop.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "floorgaps": "node tools/qa/floorgaps.mjs",
    "lightreach": "node tools/qa/lightreach.mjs",
    "perf": "node tools/qa/perf.mjs",
    "playtest": "node tools/qa/playtest.mjs",
    "playthrough": "node tools/qa/playthrough.mjs",
    "portalgraph": "node tools/qa/portalgraph.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "props": "node tools/qa/props.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "vite": "^6.0.0"
  }
}
